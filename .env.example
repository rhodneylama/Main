# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
# Cost is per-token, typically a few cents per practice call.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for the AI prospect and the scorecard.
# PROSPECT_MODEL=claude-opus-5
# SCORING_MODEL=claude-opus-5

# Optional: where the SQLite database lives (defaults to ./data/trainer.db)
# TRAINER_DB_PATH=./data/trainer.db

# --- Optional upgrade: natural-sounding prospect voice -----------------------
# Leave unset to use the browser's built-in speech synthesis (free).
# Set both to route the prospect's voice through ElevenLabs instead.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
