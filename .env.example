# --- GoHighLevel ------------------------------------------------------------
# The pipeline, users and opportunities behind every number on the board.
# These can also be set in the app under Settings → GoHighLevel, which stores
# them in the database instead. Values here win only when nothing is stored.
#
# Create a token under Settings → Private Integrations in GoHighLevel.
# GHL_API_TOKEN=pit-...
# GHL_LOCATION_ID=

# Shared secret for inbound webhooks. When set, GoHighLevel must send it as an
# x-webhook-secret header. Leave unset only on a private network.
# GHL_WEBHOOK_SECRET=

# Override the API base, e.g. to point at a mock during development.
# GHL_API_BASE=https://services.leadconnectorhq.com

# --- Training (AI practice calls) -------------------------------------------
# Required only for the cold-call trainer. Everything else works without it.
# Cost is per-token, typically a few cents per practice call.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for the AI prospect and the scorecard.
# PROSPECT_MODEL=claude-opus-5
# SCORING_MODEL=claude-opus-5

# --- Storage ----------------------------------------------------------------
# Where the SQLite database lives (defaults to ./data/salesfloor.db)
# SALESFLOOR_DB_PATH=./data/salesfloor.db

# Where uploaded training files live (defaults to ./data/uploads)
# SALESFLOOR_UPLOAD_DIR=./data/uploads

# Set to false to start with an empty floor instead of the demo team.
# SALESFLOOR_SEED_DEMO=false

# --- Display ----------------------------------------------------------------
# Currency used everywhere money is shown.
# NEXT_PUBLIC_CURRENCY=USD

# --- Optional upgrade: natural-sounding prospect voice -----------------------
# Leave unset to use the browser's built-in speech synthesis (free).
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Hosting ----------------------------------------------------------------
# One shared password for the whole site. REQUIRED when hosting anywhere the
# public internet can reach — without it, anyone with the URL sees your revenue
# and can log activity as any rep. Leave unset only on a private network.
# SALESFLOOR_PASSWORD=
