# Wingman configuration. Copy to .env and fill in. Blank values count as unset.

# Anthropic API key (required for real runs; replay --mock works without it).
ANTHROPIC_API_KEY=

# Model for the live loop, research and post-call writing.
WINGMAN_MODEL=claude-sonnet-5-5

# Effort for the live nudge loop. low keeps nudges fast; raise to medium if
# replay shows the nudges are too shallow.
WINGMAN_LIVE_EFFORT=low

# Seconds between analysis passes while someone keeps talking. A pass also
# runs as soon as the prospect finishes a turn.
WINGMAN_INTERVAL_SECONDS=12

# Your name as it appears in the meeting transcript, so Wingman knows which
# speaker is you. Comma separate several spellings.
WINGMAN_REP_NAMES=Rhodney

# Turn web research on lookups on or off (true/false).
WINGMAN_RESEARCH=true

# Where the SQLite file lives.
WINGMAN_DB_PATH=./data/wingman.db

# Folder replay mode reads transcripts from.
WINGMAN_SAMPLES_DIR=../samples

PORT=3001

# Step 2 (not used yet). Recall.ai bot API.
RECALL_API_KEY=
RECALL_REGION=us-west-2
PUBLIC_BASE_URL=
